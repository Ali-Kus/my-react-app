<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<FlowPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1">
    <children>

        <!--    Le HEADER (logo, titre) -->

        <HBox alignment="CENTER" prefHeight="100.0" prefWidth="600.0" style="-fx-background-color: #662C91;">
            <children>
                <ImageView fitHeight="53.0" fitWidth="58.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../img/logo.png" />
                    </image>
                    <HBox.margin>
                        <Insets right="20.0" />
                    </HBox.margin>
                </ImageView>
                <Label text="LiveSet" textFill="WHITE">
                    <font>
                        <Font name="Arial Bold" size="36.0" />
                    </font>
                    <opaqueInsets>
                        <Insets />
                    </opaqueInsets>
                </Label>
            </children>
        </HBox>
        <!--        -->
        <!--    Menu Panel    -->
        <VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="301.0" prefWidth="168.0">
            <children>
                <Button mnemonicParsing="false" prefHeight="59.5" prefWidth="167.0" text="Concert" />
                <Button mnemonicParsing="false" prefHeight="59.5" prefWidth="167.0" text="Lieu" />
                <Button mnemonicParsing="false" prefHeight="59.5" prefWidth="167.0" text="Sous-Traitance" />
                <Button mnemonicParsing="false" prefHeight="59.5" prefWidth="167.0" text="Artiste" />
                <Button mnemonicParsing="false" prefHeight="59.5" prefWidth="167.0" text="Financements" />
            </children>
        </VBox>
        <!--        -->
        <!--    Info Concert    -->
        <VBox prefHeight="197.0" prefWidth="431.0">
            <children>
                <GridPane prefHeight="106.0" prefWidth="431.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label text="Nom :" GridPane.rowIndex="1">
                            <font>
                                <Font name="Arial" size="15.0" />
                            </font>
                        </Label>
                        <Label text="Le Grand Concert" textFill="#662c91" GridPane.rowIndex="2">
                            <font>
                                <Font name="Arial" size="15.0" />
                            </font>
                        </Label>
                        <Label text="Prix du billet :" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <GridPane.margin>
                                <Insets left="10.0" />
                            </GridPane.margin>
                            <font>
                                <Font name="Arial" size="15.0" />
                            </font>
                        </Label>
                        <Label text="26€" textFill="#662c91" GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <GridPane.margin>
                                <Insets left="10.0" />
                            </GridPane.margin>
                            <font>
                                <Font name="Arial" size="15.0" />
                            </font>
                        </Label>
                        <Label text="Concert">
                            <font>
                                <Font size="22.0" />
                            </font>
                        </Label>
                    </children>
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </GridPane>
                <Label text="Date :">
                    <VBox.margin>
                        <Insets bottom="3.0" />
                    </VBox.margin>
                    <font>
                        <Font name="Arial" size="15.0" />
                    </font>
                </Label>
                <Label text="2 juillet 2024 à 20h00 au 3 juillet à 02h00" textFill="#662c91">
                    <font>
                        <Font name="Arial" size="15.0" />
                    </font>
                </Label>
            </children>
            <padding>
                <Insets left="20.0" />
            </padding>
        </VBox>
    </children>
</FlowPane>
