<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<FlowPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1">
    <children>

        <!--   Le HEADER (logo, titre)   -->
        <HBox alignment="CENTER" prefHeight="100.0" prefWidth="600.0" style="-fx-background-color: #662C91;">
            <children>
                <ImageView fitHeight="53.0" fitWidth="58.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../img/logo.png" />
                    </image>
                    <HBox.margin>
                        <Insets right="20.0" />
                    </HBox.margin>
                </ImageView>
                <Label text="LiveSet" textFill="WHITE">
                    <font>
                        <Font name="Arial Bold" size="36.0" />
                    </font>
                    <opaqueInsets>
                        <Insets />
                    </opaqueInsets>
                </Label>
            </children>
        </HBox>
        <!--        -->
        <!--    Menu Panel    -->
        <VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="301.0" prefWidth="168.0">
            <children>
                <Button mnemonicParsing="false" prefHeight="59.5" prefWidth="167.0" text="Concert" />
                <Button mnemonicParsing="false" prefHeight="59.5" prefWidth="167.0" text="Lieu" />
                <Button mnemonicParsing="false" prefHeight="59.5" prefWidth="167.0" text="Sous-Traitance" />
                <Button mnemonicParsing="false" prefHeight="59.5" prefWidth="167.0" text="Artiste" />
                <Button mnemonicParsing="false" prefHeight="59.5" prefWidth="167.0" text="Financements" />
            </children>
        </VBox>
        <!--        -->
        <!--    Info Lieu    -->
        <VBox prefHeight="297.0" prefWidth="432.0">
            <children>
                <Label text="Lieu">
                    <font>
                        <Font size="22.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="8.0" top="20.0" />
                    </VBox.margin>
                </Label>
                <Label text="Adresse :">
                    <VBox.margin>
                        <Insets bottom="3.0" />
                    </VBox.margin>
                    <font>
                        <Font name="Arial" size="15.0" />
                    </font>
                </Label>
                <Label fx:id="adresseLieu" text="Stade des Alpes, Grenoble 38000, France" textFill="#662c91">
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                    <font>
                        <Font name="Arial" size="15.0" />
                    </font>
                </Label>
                <GridPane prefHeight="40.0" prefWidth="400.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label text="Place maximum :">
                            <font>
                                <Font name="Arial" size="15.0" />
                            </font>
                        </Label>
                        <Label text="35 000" textFill="#662c91" GridPane.rowIndex="1">
                            <font>
                                <Font name="Arial" size="15.0" />
                            </font>
                        </Label>
                        <Label text="Prix :" GridPane.columnIndex="1">
                            <GridPane.margin>
                                <Insets left="10.0" />
                            </GridPane.margin>
                            <font>
                                <Font name="Arial" size="15.0" />
                            </font>
                        </Label>
                        <Label text="18 000€" textFill="#662c91" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <GridPane.margin>
                                <Insets left="10.0" />
                            </GridPane.margin>
                            <font>
                                <Font name="Arial" size="15.0" />
                            </font>
                        </Label>
                    </children>
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </GridPane>
                <GridPane prefHeight="40.0" prefWidth="400.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label text="Email :">
                            <font>
                                <Font name="Arial" size="15.0" />
                            </font>
                        </Label>
                        <Label text="contact@stadealpes.fr" textFill="#662c91" GridPane.rowIndex="1">
                            <font>
                                <Font name="Arial" size="15.0" />
                            </font>
                        </Label>
                        <Label text="Téléphone :" GridPane.columnIndex="1">
                            <GridPane.margin>
                                <Insets left="10.0" />
                            </GridPane.margin>
                            <font>
                                <Font name="Arial" size="15.0" />
                            </font>
                        </Label>
                        <Label text="+33 4 55 66 77 88" textFill="#662c91" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <GridPane.margin>
                                <Insets left="10.0" />
                            </GridPane.margin>
                            <font>
                                <Font name="Arial" size="15.0" />
                            </font>
                        </Label>
                    </children>
                </GridPane>
            </children>
            <padding>
                <Insets left="20.0" />
            </padding>
        </VBox>
    </children>
</FlowPane>
